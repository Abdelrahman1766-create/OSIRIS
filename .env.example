# Keep this relative for the Vite proxy in local development. This avoids VPN DNS routing.
# Set to the public backend API URL in Vercel, for example https://your-api.onrender.com/api/v1
VITE_API_URL=/api/v1
# Public storefront origin, for canonical and Open Graph URLs after deployment.
VITE_SITE_URL=
# Optional build-time absolute API base for product URLs in sitemap.xml.
SITEMAP_API_URL=

# Digits with country code, no plus sign, for wa.me links.
VITE_WHATSAPP_NUMBER=
# Telegram username without the @ sign.
VITE_TELEGRAM_USERNAME=
# Full public MAX profile or contact URL, including https://.
VITE_MAX_CONTACT_URL=
# Optional public brand Instagram profile URL.
VITE_INSTAGRAM_URL=

# Local Docker PostgreSQL. Set a private password before running Docker Compose.
POSTGRES_DB=royal_essence
POSTGRES_USER=royal_essence
POSTGRES_PASSWORD=
